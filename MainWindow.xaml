<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1400" Icon="/Res/Чудо Обувь.ico" FontFamily="Calibri">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Background="#D2F6E7">
            
        </StackPanel>
        <Image Source="/Res/Чудо Обувь.ico" HorizontalAlignment="Left"></Image>
        <TextBlock Text="Gostenova Чудо Обувь" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="35" Width="535" />
        <Button x:Name="BtnBack" Content="Назад" Click="BtnBack_Click" HorizontalAlignment="Right"/>
        <Frame Grid.Row="1" Name="MainFrame" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered"></Frame>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Background="#D2F6E7"></StackPanel>
    </Grid>
</Window>
