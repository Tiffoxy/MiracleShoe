<Page x:Class="WpfApp1.OrderHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderHistoryPage" FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Список заказов" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Name="CreateOrderBtn" Content="Создать заказ" Width="160" Height="36" FontSize="16" Click="CreateOrderBtn_Click" Visibility="Collapsed"/>
            <Button Name="DeleteOrderBtn" Content="Удалить заказ" Width="160" Height="36" FontSize="16" Click="DeleteOrderBtn_Click" Visibility="Collapsed"/>
        </StackPanel>
        
        <ListView Grid.Row="1" Name="OrderListView" Margin="10" MouseDoubleClick="OrderListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="№" DisplayMemberBinding="{Binding OrderID}" Width="80"/>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="150"/>
                    <GridViewColumn Header="Клиент" DisplayMemberBinding="{Binding ClientFIO}" Width="350"/>
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding TotalSum}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>