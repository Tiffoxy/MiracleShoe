<Window x:Class="WpfApp1.ProductSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор товара"
        Height="500" Width="700"
        FontFamily="Calibri">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите товар" FontSize="20" FontWeight="Bold"/>

        <ListView Grid.Row="1" Name="ProductListView" MouseDoubleClick="ProductListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding ProductName}" Width="420"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2}}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Выбрать" Width="140" Height="38" FontSize="16" Click="SelectButton_Click"/>
            <Button Content="Отмена" Width="120" Height="38" FontSize="16" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>