<Page x:Class="WpfApp1.AuthoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthoPage" FontFamily="Calibri">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>            
        </Grid.RowDefinitions>
        <TextBlock Text="Логин" FontSize="55" HorizontalAlignment="Right" VerticalAlignment="Center"></TextBlock>
        <TextBox Name="TBLogin" FontSize="40" Width="400" Height="42" Grid.Column="1"></TextBox>
        <Button Name="GuestBtn" Grid.Row="1" Content="Войти кaк гость" Click="GuestBtn_Click"></Button>
        <Button Name="LoginBtn" Grid.Row="1" Grid.Column="1" Content="Войти" Click="LoginBtn_Click"></Button>
    </Grid>
</Page>
