<Window x:Class="WpfApp1.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина"
        Height="550" Width="950"
        FontFamily="Calibri"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- заголовок -->
            <RowDefinition Height="*"/>
            <!-- состав -->
            <RowDefinition Height="Auto"/>
            <!-- итого -->
            <RowDefinition Height="Auto"/>
            <!-- кнопки -->
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК -->
        <TextBlock Grid.Row="0"
                   Text="Корзина"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <ListView Grid.Row="1" Name="CartItemsListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар"
                            DisplayMemberBinding="{Binding ProductName}"
                            Width="380"/>
                    <GridViewColumn Header="Размер"
                            DisplayMemberBinding="{Binding SizeText}"
                            Width="90"/>
                    <GridViewColumn Header="Кол-во" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="−" Width="28" Height="28"
                        FontSize="16"
                        Click="MinusButton_Click"
                        DataContext="{Binding}"/>
                                    <TextBlock Text="{Binding Quantity}"
                           FontSize="16" FontWeight="Bold"
                           Width="40"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>
                                    <Button Content="+" Width="28" Height="28"
                        FontSize="16"
                        Click="PlusButton_Click"
                        DataContext="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Цена"
                            DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2}}"
                            Width="110"/>
                    <GridViewColumn Header="Сумма"
                            DisplayMemberBinding="{Binding LineSum, StringFormat={}{0:N2}}"
                            Width="120"/>
                    <GridViewColumn Header="" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Удалить"
                    Width="90" Height="28"
                    FontSize="14"
                    Click="RemoveButton_Click"
                    DataContext="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Row="2"
                   Name="TotalText"
                   Text="Итого: "
                   FontSize="20"
                   HorizontalAlignment="Right"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Оформить заказ"
                    Width="180" Height="38"
                    FontSize="16"
                    Margin="0,0,10,0"
                    Click="CheckoutButton_Click"/>
            <Button Content="Закрыть"
                    Width="120" Height="38"
                    FontSize="16"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>